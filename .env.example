# Compose reads .env from the repository root.
EKYC_APP_PORT=8081
# On Linux set this to your numeric UID:GID if it differs from 1000:1000.
EKYC_CONTAINER_USER=1000:1000
# Path inside the app container, e.g. /app/runs/selected/bundle.
EKYC_MODEL_BUNDLE=
# Alternatively connect to a managed HTTPS scoring endpoint.
EKYC_SCORING_URL=
EKYC_SCORING_KEY=
EKYC_SCORING_DEPLOYMENT=
# Mount a dataset folder or one prepared review batch.
EKYC_REVIEW_MEDIA=./Data
EKYC_LABEL_STUDIO_PORT=8080
# Optional in-app review. Use container paths under /app/Data or /app/runs.
EKYC_REVIEW_QUEUE=
EKYC_REVIEW_MANIFEST=
EKYC_REVIEW_DATASET_ROOT=
EKYC_REVIEW_BATCH=
EKYC_LABEL_STUDIO_PROJECT=
# Optional Azure dashboard sources via compose.azure.yaml.
AZ_SUBSCRIPTION=
AZ_RESOURCE_GROUP=
AZ_WORKSPACE=
AZ_ENDPOINT=
EKYC_LOG_ANALYTICS_WORKSPACE=
EKYC_AZURE_LOGS_ARCHIVED=0
